[Unit]
Description=Minhas Finanças (API + web)
After=network-online.target
Wants=network-online.target

[Service]
User=financas
WorkingDirectory=/opt/financas/backend
# FINANCAS_TOKEN, FINANCAS_DB e TZ
EnvironmentFile=/etc/financas.env
ExecStart=/opt/financas/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/financas

[Install]
WantedBy=multi-user.target
